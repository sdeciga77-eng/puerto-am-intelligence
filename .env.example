# Copia este archivo como .env y ajusta los valores. NUNCA subas .env a Git.
# En producción usa variables de entorno reales del orquestador.

# ---------- Autenticación del panel ----------
ADMIN_USER=admin
# Recomendado: hash PBKDF2 generado con scripts/set_admin_password.py
ADMIN_PASSWORD_HASH=
# Solo para desarrollo local (texto plano). No usar en producción.
ADMIN_PASSWORD=
SESSION_TTL_MINUTES=480
COOKIE_SECURE=false
TRUST_PROXY=false
ENABLE_DOCS=false

# ---------- n8n ----------
# Webhook público: SOLO preguntas de reservas/horarios/servicios/contacto.
N8N_PUBLIC_WEBHOOK_URL=
# Webhook financiero: recibe preguntas + hechos verificados del Excel.
N8N_FINANCE_WEBHOOK_URL=
# Webhook de acciones: reportes, Gmail, Drive, CFDI, National Soft.
N8N_ACTIONS_WEBHOOK_URL=
# Webhook de formulario de contacto.
N8N_CONTACT_WEBHOOK_URL=
# Token opcional enviado como X-Webhook-Token a todos los webhooks.
N8N_WEBHOOK_TOKEN=
WEBHOOK_TIMEOUT_SECONDS=8

# ---------- OpenRouter (credencial SOLO del servidor; nunca en el frontend) ----------
# Modelo gratuito probado: google/gemma-4-26b-a4b-it:free
# La cuota gratuita de la demo es de 50 peticiones/día; se usa cache y fallback.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_FALLBACK_MODELS=openrouter/free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,baidu/ernie-5.5-flash-preview:free
OPENROUTER_TIMEOUT_SECONDS=15
OPENROUTER_MAX_TOKENS=450

# ---------- Datos públicos (nunca financieros) ----------
PUBLIC_EMAIL=
PUBLIC_PHONE=
PUBLIC_ADDRESS=
PUBLIC_HOURS=
PUBLIC_WHATSAPP_URL=
PUBLIC_INSTAGRAM_URL=
